<template>
  <div class="page">
    <text class="brand">GYMLOG</text>
    <text class="ok">IT RUNS</text>
    <text class="tag">{{buildTag}}</text>
    <div class="btn" onclick="bump">
      <text class="btnText">TAP {{count}}</text>
    </div>
  </div>
</template>

<script>
import buildInfo from '../../common/build-info'

export default {
  private: {
    buildTag: buildInfo.tag,
    count: 0
  },

  onShow() {
    console.log('[gymlog] onShow, build=' + buildInfo.tag)
  },

  bump() {
    this.count = this.count + 1
    console.log('[gymlog] tap ' + this.count)
  }
}
</script>

